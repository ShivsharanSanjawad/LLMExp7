# ---- LM Studio (OpenAI-compatible local server) ----
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=REPLACE_ME
LLM_API_KEY=lm-studio
# json_schema for LM Studio; use function_calling for Groq / OpenRouter
LLM_STRUCTURED_METHOD=json_schema

# ---- Qdrant Cloud ----
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION=insurance_support_bot

# ---- Pipeline thresholds (replace SCORE_THRESHOLD with your calibrated Experiment 6 value) ----
SCORE_THRESHOLD=0.45
GROUNDING_MIN=0.60

# ---- API ----
API_KEY=
API_URL=http://127.0.0.1:8000

# ---- MLflow ----
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
